<?xml version="1.0" encoding="utf-8"?>
<!-- Night mode panel under the moon pill: on/off, then the dim and warm bars (Left and Right move them). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="8dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="12dp">

    <TextView
        android:id="@+id/nightToggle"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/input_row_bg"
        android:drawableStart="@drawable/ic_moon"
        android:drawablePadding="10dp"
        android:drawableTint="@drawable/pill_text"
        android:textColor="@drawable/pill_text"
        android:textSize="15sp"
        android:fontFamily="@font/outfit_medium"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/nightDimLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="12dp"
        android:text="@string/night_dim"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.16"
        android:textAllCaps="true" />

    <com.gathin.tvhome.GlassSlider
        android:id="@+id/nightDim"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/nightWarmLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:text="@string/night_warm"
        android:textColor="#B3FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.16"
        android:textAllCaps="true" />

    <com.gathin.tvhome.GlassSlider
        android:id="@+id/nightWarm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/nightHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
