<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings in sections, top to bottom: Apps, Home screen, Wallpaper, Liquid Glass, Widgets, Motion,
     System. Rows are focusable text views: OK toggles a switch, cycles a choice or opens a picker. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0E13"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingEnd="96dp"
        android:paddingTop="38dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@font/outfit_light" />

        <!-- Apps -->
        <TextView style="@style/SettingsSection" android:text="@string/section_apps" />

        <TextView android:id="@+id/reorderAppsChoice" style="@style/SettingsRow" android:text="@string/organize_apps" />
        <TextView style="@style/SettingsHint" android:text="@string/organize_settings_hint" />

        <!-- Home screen -->
        <TextView style="@style/SettingsSection" android:text="@string/section_home" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/columns_label"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
            <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
            <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
            <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/rows_below_dock_label"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
        </LinearLayout>

        <!-- Wallpaper -->
        <TextView style="@style/SettingsSection" android:text="@string/section_wallpaper" />

        <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow" />
        <TextView android:id="@+id/wallpaperDimChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
        <TextView style="@style/SettingsHint" android:text="@string/wallpaper_settings_hint" />

        <!-- Liquid Glass -->
        <TextView style="@style/SettingsSection" android:text="@string/section_glass" />

        <TextView android:id="@+id/liquidGlassChoice" style="@style/SettingsRow" />
        <TextView android:id="@+id/glassBlurChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
        <TextView style="@style/SettingsHint" android:text="@string/glass_hint" />

        <!-- Widgets -->
        <TextView style="@style/SettingsSection" android:text="@string/section_widgets" />

        <TextView android:id="@+id/btcChoice" style="@style/SettingsRow" />
        <TextView android:id="@+id/nowPlayingChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
        <TextView android:id="@+id/nowPlayingHint" style="@style/SettingsHint" android:text="@string/now_playing_hint" />

        <!-- Motion -->
        <TextView style="@style/SettingsSection" android:text="@string/section_motion" />

        <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow" />
        <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
        <TextView style="@style/SettingsHint" android:text="@string/advanced_effects_warning" />

        <!-- System -->
        <TextView style="@style/SettingsSection" android:text="@string/section_system" />

        <TextView android:id="@+id/screensaverChoice" style="@style/SettingsRow" android:text="@string/screensaver_settings" />

        <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow" android:layout_marginTop="10dp"
            android:text="@string/home_settings" />
        <TextView style="@style/SettingsHint" android:text="@string/home_settings_help" />

        <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow" android:layout_marginTop="10dp"
            android:text="@string/tv_settings" />

        <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow" android:layout_marginTop="10dp"
            android:text="@string/follow_theme" />
        <TextView style="@style/SettingsHint" android:text="@string/follow_theme_hint" />
    </LinearLayout>
</ScrollView>
